{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior rules v1",
  "type": "object",
  "required": ["schema_version", "revision", "window_seconds", "lateness_tolerance_ms", "max_entities", "min_event_count", "score_cutoff", "rules"],
  "properties": {
    "schema_version": {"const": "rules.v1"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "window_seconds": {"enum": [10, 30, 60]},
    "lateness_tolerance_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "max_entities": {"type": "integer", "minimum": 1, "maximum": 100000},
    "min_event_count": {"type": "integer", "minimum": 1, "maximum": 100000},
    "score_cutoff": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "feature", "operator", "threshold", "weight", "min_sample_count"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "feature": {"enum": ["event_count", "unique_modified_files", "unique_renamed_files", "unique_deleted_files", "unique_extension_types"]},
          "operator": {"enum": [">=", ">", "<=", "<", "=="]},
          "threshold": {"type": "integer", "minimum": 0, "maximum": 1000000},
          "weight": {"type": "integer", "minimum": 0, "maximum": 100000},
          "min_sample_count": {"type": "integer", "minimum": 1, "maximum": 100000}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
