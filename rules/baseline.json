{
  "schema_version": "rules.v1",
  "revision": "lab-baseline-002",
  "window_seconds": 30,
  "lateness_tolerance_ms": 2000,
  "max_entities": 10000,
  "min_event_count": 10,
  "score_cutoff": 60,
  "rules": [
    {"id": "R-MASS-REWRITE", "feature": "unique_modified_files", "operator": ">=", "threshold": 40, "weight": 60, "min_sample_count": 10},
    {"id": "R-MASS-RENAME", "feature": "unique_renamed_files", "operator": ">=", "threshold": 30, "weight": 60, "min_sample_count": 10},
    {"id": "R-MASS-DELETE", "feature": "unique_deleted_files", "operator": ">=", "threshold": 30, "weight": 60, "min_sample_count": 10},
    {"id": "R-EXTENSION-DIVERSITY", "feature": "unique_extension_types", "operator": ">=", "threshold": 8, "weight": 20, "min_sample_count": 10}
  ]
}
